# DATABASE_URL=postgres://...
# UPLOAD_DIR=/persistent/path/uploads
# STORAGE_PROVIDER=s3-compatible
# STORAGE_BUCKET=...
# STORAGE_ENDPOINT=...
# STORAGE_ACCESS_KEY_ID=...
# STORAGE_SECRET_ACCESS_KEY=...
# AI_PROVIDER=...
# AI_API_KEY=...
# SUPABASE_URL=https://your-project.supabase.co
